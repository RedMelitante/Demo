// Cloudflare Workers static-assets deployment.
// Build with `npm run build`, then `npx wrangler deploy` uploads dist/.
// Having this file stops Wrangler's automatic project setup, which this static site doesn't need.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "demo",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
